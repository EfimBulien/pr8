# =====================================================================
# Исключения Git для проекта pr8 (C++, Visual Studio / MSVC v145)
# Если нужный файл пропал из git status — проверьте, не ловится ли он
# одним из шаблонов ниже (git check-ignore -v <файл>).
# =====================================================================

# --- Каталоги сборки и промежуточные результаты -----------------------
# MSBuild раскладывает их так:
#   x64/Debug/      — выход: pr8.exe, pr8.pdb
#   pr8/x64/Debug/  — промежуточные: *.obj, *.tlog, *.idb, vc145.pdb
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Oo]ut/

# --- Результаты сборки ------------------------------------------------
*.obj
*.o
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.pch
*.pgc
