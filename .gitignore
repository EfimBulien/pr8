# --- Личные настройки проекта ----------------------------------------
# pr8.vcxproj.user создаётся студией и хранит локальные пути и параметры
*.vcxproj.user

# --- Visual Studio Code -----------------------------------------------
# Настройки редактора считаем личными (в .vscode/settings.json сейчас
# прописан абсолютный путь к компилятору этой машины).
# Захотите делиться ими с другими — уберите строку ".vscode/" и
# раскомментируйте нужные исключения ниже.
.vscode/
#!.vscode/settings.json
#!.vscode/launch.json
#!.vscode/tasks.json
#!.vscode/extensions.json

# --- Прочее -----------------------------------------------------------
# Символы отладки от старой сборки на macOS
*.dSYM/
*.dSYM
